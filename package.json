{
  "name": "job-swipe-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "dev:restart": "pkill -f \"node node_modules/next/dist/bin/next dev\" || true; npm run dev",
    "dev:share": "bash scripts/dev-share.sh up",
    "dev:share:restart": "bash scripts/dev-share.sh restart",
    "dev:share:stop": "bash scripts/dev-share.sh stop",
    "dev:share:status": "bash scripts/dev-share.sh status",
    "automation:worker": "node scripts/automation-worker.js",
    "automation:stagehand": "node tools/stagehand-runner/server.mjs",
    "postinstall": "npm run prisma:generate",
    "build": "npm run prisma:generate && node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "node node_modules/next/dist/bin/next lint",
    "prisma:generate": "node node_modules/prisma/build/index.js generate",
    "prisma:push": "node node_modules/prisma/build/index.js db push"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "next": "15.0.4",
    "openai": "^6.27.0",
    "pdf-parse": "^1.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "playwright": "^1.58.2",
    "prisma": "5.22.0",
    "typescript": "5.6.3"
  }
}
