        "webhookId": "6cd679f7-6045-493c-9ca2-726ba392b3ec"
      },
      {
        "parameters": {
          "jsCode": "const incoming = $input.first().json;\nconst trigger = incoming.body ?? incoming;\nconst headers = incoming.headers ?? {};\nconst automationSecret = headers['x-automation-secret'] || headers['X-Automation-Secret'] || '';\n\nconst contextUrl = trigger.app?.contextUrl ?? '';\nconst callbackUrl = trigger.app?.callbackUrl ?? '';\nconst jobUrl = trigger.job?.url ?? '';\n\nif (!/^https?:\\/\\//.test(contextUrl)) {\n  throw new Error('Invalid context URL in webhook payload');\n}\nif (!/^https?:\\/\\//.test(callbackUrl)) {\n  throw new Error('Invalid callback URL in webhook payload');\n}\nif (!jobUrl) {\n  throw new Error('Missing job URL in webhook payload');\n}\nif (!automationSecret) {\n  throw new Error('Missing automation secret header on webhook request');\n}\n\nreturn [{\n  json: {\n    reason: trigger.reason ?? 'queued',\n    run: trigger.run ?? {},\n    job: trigger.job ?? {},\n    profile: trigger.profile ?? {},\n    app: trigger.app ?? {},\n    contextUrl,\n    callbackUrl,\n    jobUrl,\n    automationSecret\n  }\n}];"
        },
        "id": "7f5a38f5-0e90-4a28-bbed-55b271752c4b",
        "name": "Prepare Dispatch Input",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          240,
          0
        ]
      },
      {
        "parameters": {
          "method": "GET",
          "url": "={{ $(\"Prepare Dispatch Input\").item.json.contextUrl }}",
          "authentication": "none",
          "sendHeaders": true,
          "specifyHeaders": "keypair",
          "headerParameters": {
            "parameters": [
              {
                "name": "x-automation-secret",
                "value": "={{ $(\"Prepare Dispatch Input\").item.json.automationSecret }}"
              },
              {
                "name": "accept",
                "value": "application/json"
              }
            ]
          },
          "options": {}
        },
        "id": "61e7a17e-715d-468a-bb65-b22eb482902d",
        "name": "Fetch Run Context",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          480,
          0
        ]
      },
      {
        "parameters": {
          "jsCode": "const dispatch = $('Prepare Dispatch Input').item.json || {};\nconst context = $input.first().json || {};\nconst run = context.run || dispatch.run || {};\nconst job = { ...(run.job || dispatch.job || {}), url: dispatch.jobUrl || (run.job || dispatch.job || {}).url || '' };\nconst profile = context.profile || dispatch.profile || {};\nconst appBaseUrl = context.appBaseUrl || dispatch.app?.baseUrl || '';\n\nreturn [{\n  json: {\n    callbackUrl: dispatch.callbackUrl,\n    automationSecret: dispatch.automationSecret,\n    runnerInput: {\n      app: { baseUrl: appBaseUrl },\n      run: { ...run, job },\n      profile\n    }\n  }\n}];"
        },
        "id": "d4dfd3f2-26b5-4a6e-b69e-3f00c0407ee1",
