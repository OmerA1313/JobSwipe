        "id": "1b872104-2461-4493-8c29-212f37b4229c",
        "name": "Run Stagehand",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          1200,
          0
        ],
        "onError": "continueRegularOutput"
      },
      {
        "parameters": {
          "jsCode": "const raw = $input.first().json || {};\nconst validStatuses = new Set(['SUBMITTED', 'NEEDS_INPUT', 'FAILED']);\nconst status = validStatuses.has(raw.status) ? raw.status : 'FAILED';\nconst message = raw.message || (status === 'SUBMITTED' ? 'Application submitted successfully.' : status === 'NEEDS_INPUT' ? 'Automation requires manual input.' : 'Stagehand runner failed.');\nreturn [{\n  json: {\n    status,\n    currentStep: raw.currentStep || (status === 'SUBMITTED' ? 'Application submitted' : status === 'NEEDS_INPUT' ? 'Waiting for manual input' : 'Automation failed'),\n    needsInput: raw.needsInput ?? (status === 'NEEDS_INPUT'),\n    blockingQuestion: raw.blockingQuestion ?? null,\n    inputField: raw.inputField ?? null,\n    lastError: raw.lastError ?? (status === 'FAILED' ? message : null),\n    message,\n    level: raw.level || (status === 'FAILED' ? 'ERROR' : status === 'NEEDS_INPUT' ? 'WARN' : 'INFO'),\n    payload: raw.payload ?? null\n  }\n}];"
        },
