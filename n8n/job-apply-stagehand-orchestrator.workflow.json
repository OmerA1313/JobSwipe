          "method": "POST",
          "url": "={{ $(\"Prepare Stagehand Request\").item.json.callbackUrl }}",
          "authentication": "none",
          "sendHeaders": true,
          "specifyHeaders": "keypair",
          "headerParameters": {
            "parameters": [
              {
                "name": "content-type",
                "value": "application/json"
              },
              {
                "name": "x-automation-secret",
                "value": "={{ $(\"Prepare Stagehand Request\").item.json.automationSecret }}"
              }
            ]
          },
          "sendBody": true,
          "contentType": "json",
          "specifyBody": "json",
          "jsonBody": "={\"status\":\"RUNNING\",\"currentStep\":\"Stagehand runner started\",\"message\":\"Stagehand started the local browser automation.\"}",
          "options": {}
        },
