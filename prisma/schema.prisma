generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model UserProfile {
  id                 Int      @id
  fullName           String?
  email              String?
  phone              String?
  resumeText         String?
  resumeFileName     String?
  resumeFileMimeType String?
  resumeFileData     Bytes?
  desiredRole        String?
  seniorityPreference String   @default("any")
  preferredLocations String?
  preferredSalaryMin Int?
  remotePreference   String   @default("hybrid")
  visaStatus         String?
  yearsExperience    Int?
  linkedInUrl        String?
  githubUrl          String?
  portfolioUrl       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model JobPosting {
  id                     Int             @id @default(autoincrement())
  externalId             String          @unique
  title                  String
  company                String
  location               String
  isRemote               Boolean         @default(false)
  salaryMin              Int?
  salaryMax              Int?
  url                    String
  summary                String
  source                 String          @default("mock")
  llmDescriptionBullets  String?
  llmRequirementsBullets String?
  llmSummaryHash         String?
  llmModel               String?
  llmEnrichedAt          DateTime?
  createdAt              DateTime        @default(now())
  decisions              JobDecision[]
  application            Application?
  automationRuns AutomationRun[]
}

model JobDecision {
  id        Int          @id @default(autoincrement())
  jobId      Int          @unique
  decision   String
  reason     String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  job        JobPosting   @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model Application {
  id             Int               @id @default(autoincrement())
  jobId           Int               @unique
  status          String            @default("SUBMITTED")
  tailoredResume  String
  coverLetter     String
  resumeFileName  String?
  resumeFileMimeType String?
  resumeFileData  Bytes?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  job             JobPosting        @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model AutomationRun {
  id               Int               @id @default(autoincrement())
  jobId             Int
  siteType          String
  status            String            @default("QUEUED")
  currentStep       String?
  needsInput        Boolean           @default(false)
  blockingQuestion  String?
  inputField        String?
  answersJson       String?
  lastError         String?
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  job               JobPosting        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  events            AutomationEvent[]

  @@index([status, createdAt])
}

model AutomationEvent {
  id          Int            @id @default(autoincrement())
  runId        Int
  level       String         @default("INFO")
  message     String
  payload     String?
  createdAt   DateTime       @default(now())
  run         AutomationRun  @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
}
